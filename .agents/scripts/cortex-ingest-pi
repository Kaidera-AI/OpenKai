#!/usr/bin/env bash
# cortex-ingest-pi — ingest one Pi session through the Cortex API.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_cortex_api.sh
source "${SCRIPT_DIR}/_cortex_api.sh"

usage() {
    echo "Usage: cortex-ingest-pi [--allow-placeholder] <jsonl-file> [agent] [project]"
}

ALLOW_PLACEHOLDER=0

while [ "$#" -gt 0 ]; do
    case "${1:-}" in
        --allow-placeholder)
            ALLOW_PLACEHOLDER=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --*)
            echo "ERROR: unknown flag: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -lt 1 ]; then
    usage
    exit 0
fi

SESSION_FILE="$1"
AGENT_NAME="${2:-${CORTEX_AGENT:-${CORTEX_AGENT_ID:-${BEAT_CORTEX_AGENT:-}}}}"
if [ -n "${3:-}" ]; then
    export CORTEX_PROJECT="$3"
fi
[ -f "${SESSION_FILE}" ] || { echo "ERROR: session file not found: ${SESSION_FILE}" >&2; exit 1; }
if [ -z "${AGENT_NAME}" ]; then
    echo "ERROR: agent is required for Pi session ingest; pass [agent] or set CORTEX_AGENT/CORTEX_AGENT_ID/BEAT_CORTEX_AGENT." >&2
    exit 2
fi
AGENT_NAME="$(cortex_agent_base_name "${AGENT_NAME}" | tr '[:upper:]' '[:lower:]')"

payload_status=0
payload="$(
python3 - "${SESSION_FILE}" "${AGENT_NAME}" "${ALLOW_PLACEHOLDER}" <<'PYEOF'
import json
import os
import sys
import uuid
from pathlib import Path

path = Path(sys.argv[1]).resolve()
agent = sys.argv[2].lower().strip() or "agent"
allow_placeholder = sys.argv[3] == "1"

# Extract session ID from filename (format: timestamp_UUID.jsonl)
stem = path.stem
# The UUID is the part after the last underscore
parts = stem.rsplit("_", 1)
if len(parts) == 2:
    try:
        session_id = str(uuid.UUID(parts[1]))
    except ValueError:
        session_id = str(uuid.uuid5(uuid.NAMESPACE_URL, str(path)))
else:
    session_id = str(uuid.uuid5(uuid.NAMESPACE_URL, str(path)))

messages = []
nonempty_lines = 0
parsed_records = 0
cwd = os.getcwd()
session_meta = None

with path.open("r", encoding="utf-8", errors="replace") as handle:
    for line_number, line in enumerate(handle, start=1):
        line = line.strip()
        if not line:
            continue
        nonempty_lines += 1
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        parsed_records += 1

        ptype = item.get("type", "")

        if ptype == "session":
            session_meta = item
            cwd = item.get("cwd", cwd)
            continue

        if ptype in ("model_change", "thinking_level_change"):
            continue

        if ptype != "message":
            continue

        msg = item.get("message") or {}
        if not isinstance(msg, dict):
            continue

        role = msg.get("role", "system")
        # Normalize roles
        if role == "toolResult":
            role = "user"  # Tool results are user context
        elif role not in ("user", "assistant", "system"):
            role = "system"

        content_parts = msg.get("content") or []
        if not isinstance(content_parts, list):
            content_parts = [{"type": "text", "text": str(content_parts)}]

        # Extract text from content parts
        text_parts = []
        for part in content_parts:
            if not isinstance(part, dict):
                text_parts.append(str(part))
                continue
            ptype2 = part.get("type", "")
            if ptype2 == "text":
                text_parts.append(str(part.get("text", "")))
            elif ptype2 == "thinking":
                thinking_text = str(part.get("thinking", ""))
                if thinking_text:
                    text_parts.append(f"[thinking] {thinking_text}")
            elif ptype2 == "toolCall":
                tc_name = part.get("name", "unknown")
                tc_args = part.get("arguments", {})
                if isinstance(tc_args, dict):
                    tc_args_str = json.dumps(tc_args, ensure_ascii=False)
                else:
                    tc_args_str = str(tc_args)
                text_parts.append(f"[toolCall: {tc_name}] {tc_args_str}")

        content = "\n".join(text_parts).strip()
        if content:
            messages.append({
                "role": role,
                "content": content,
                "metadata": {"source": "pi-local-file"}
            })

if not messages:
    if nonempty_lines > 0 and not allow_placeholder:
        print(
            f"ERROR: cortex-ingest-pi parsed zero real messages from non-empty file {path}; "
            "refusing placeholder ingest. Re-run with --allow-placeholder only if intentional.",
            file=sys.stderr,
        )
        raise SystemExit(4)
    messages.append({
        "role": "system",
        "content": f"Imported Pi session file {path.name}",
        "metadata": {"source": "pi-local-file", "placeholder": True},
    })

print(json.dumps({
    "session_uuid": session_id,
    "agent": agent,
    "task": f"Imported Pi session {path.name}",
    "source_path": str(path),
    "provider": "pi",
    "cwd": cwd,
    "source_kind": "pi-session",
    "metadata": {
        "filename": path.name,
        "nonempty_lines": nonempty_lines,
        "parsed_records": parsed_records,
        "messages_parsed": len(messages),
        "placeholder_allowed": allow_placeholder,
    },
    "messages": messages,
}))
PYEOF
)" || payload_status=$?

if [ "${payload_status}" -ne 0 ]; then
    exit "${payload_status}"
fi

cortex_api_call_json POST "/sessions/ingest" "${payload}" "${AGENT_NAME}"
printf 'Ingested %s\n' "${SESSION_FILE}"
