{
  "name": "@kaidera/openkai-core",
  "version": "0.1.9",
  "description": "OpenKai core: Cortex memory client (REST + SSE event bridge).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cortex": {
      "types": "./dist/cortex/index.d.ts",
      "default": "./dist/cortex/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2"
  }
}
