{
  "name": "@kaidera/openkai",
  "version": "0.1.9",
  "description": "OpenKai CLI + TUI — the operator surface for the OpenKai harness.",
  "type": "module",
  "bin": {
    "openkai": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/check-core-freshness.cjs",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/*.test.js",
    "test:build": "npm run -w @kaidera/openkai-core build && npm run build && npm run pretest && tsc -p tsconfig.test.json && node --test dist-test/*.test.js",
    "build:binaries": "scripts/build-binaries.sh",
    "test:e2e": "tui-test e2e/"
  },
  "keywords": [
    "agent",
    "harness",
    "tui",
    "llm",
    "openrouter",
    "cortex",
    "fusion"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@kaidera/openkai-core": "0.1.9",
    "grok-mermaid": "^0.2.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@microsoft/tui-test": "^0.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
