{
  "name": "@kaidera/openkai",
  "version": "0.1.8",
  "description": "OpenKai CLI + TUI — the operator surface for the OpenKai harness.",
  "type": "module",
  "bin": {
    "openkai": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node --input-type=commonjs -e \"const fs=require('fs'),p=require('path');const rebuild='npm run -w @kaidera/openkai-core build';const hint='Discriminator: if git grep finds the export in packages/*/src on origin/main, it is staleness, not a missing export. The stale dist is gitignored, so git status reads CLEAN while serving stale core to every worktree.';function fail(m){process.stderr.write('\\n'+m+'\\n\\n');process.exit(1);}let coreDir;try{const idx=require.resolve('@kaidera/openkai-core');coreDir=p.dirname(p.dirname(idx));}catch(e){fail('BUILD-FRESHNESS FAILURE: cannot resolve @kaidera/openkai-core.\\n  '+e.message+'\\n  Rebuild/reinstall: '+rebuild+' or npm install\\n  '+hint);}const distDir=p.join(coreDir,'dist'),buildInfo=p.join(coreDir,'tsconfig.tsbuildinfo');const idxJs=p.join(distDir,'index.js'),idxDts=p.join(distDir,'index.d.ts');if(!fs.existsSync(idxJs)||!fs.existsSync(idxDts)){fail('BUILD-FRESHNESS FAILURE: @kaidera/openkai-core dist is not built.\\n  Resolved: '+coreDir+'\\n  Missing: '+(!fs.existsSync(idxJs)?idxJs+' ':'')+idxDts+'\\n  A missing dist surfaces as TS2307 Cannot-find-module, not a real missing module.\\n  Rebuild: '+rebuild+'\\n  '+hint);}if(!fs.existsSync(buildInfo)){fail('BUILD-FRESHNESS FAILURE: @kaidera/openkai-core not built in this checkout.\\n  Resolved: '+coreDir+'\\n  tsconfig.tsbuildinfo absent — dist not produced by a build here (worktree symlink hazard).\\n  Rebuild: '+rebuild+'\\n  '+hint);}function collectTs(dir,acc){acc=acc||[];for(const e of fs.readdirSync(dir,{withFileTypes:true})){const f=p.join(dir,e.name);if(e.isDirectory())collectTs(f,acc);else if(e.isFile()&&e.name.endsWith('.ts'))acc.push(f);}return acc;}let srcNewest=0;for(const f of collectTs(p.join(coreDir,'src'))){const m=fs.statSync(f).mtimeMs;if(m>srcNewest)srcNewest=m;}const dJs=fs.statSync(idxJs).mtimeMs,dDts=fs.statSync(idxDts).mtimeMs,dBi=fs.statSync(buildInfo).mtimeMs;const stale=[];if(srcNewest>dDts)stale.push('dist/index.d.ts ('+new Date(dDts).toISOString()+') older than newest src ('+new Date(srcNewest).toISOString()+')');if(srcNewest>dJs)stale.push('dist/index.js ('+new Date(dJs).toISOString()+') older than newest src ('+new Date(srcNewest).toISOString()+')');if(srcNewest>dBi)stale.push('tsbuildinfo ('+new Date(dBi).toISOString()+') older than newest src ('+new Date(srcNewest).toISOString()+')');if(stale.length){fail('BUILD-FRESHNESS FAILURE: @kaidera/openkai-core dist is stale relative to sources.\\n  Resolved: '+coreDir+'\\n  '+stale.join('\\n  ')+'\\n  A stale dist manufactures a fake TS2305 has-no-exported-member against the TEST FILE, not a real missing-export defect.\\n  Rebuild: '+rebuild+'\\n  '+hint);}\",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/*.test.js",
    "test:build": "npm run -w @kaidera/openkai-core build && npm run build && npm run pretest && tsc -p tsconfig.test.json && node --test dist-test/*.test.js",
    "build:binaries": "scripts/build-binaries.sh",
    "test:e2e": "tui-test e2e/"
  },
  "keywords": [
    "agent",
    "harness",
    "tui",
    "llm",
    "openrouter",
    "cortex",
    "fusion"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@kaidera/openkai-core": "0.1.8",
    "grok-mermaid": "^0.2.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@microsoft/tui-test": "^0.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
