{
  "name": "@openkai/cli",
  "version": "0.0.0",
  "description": "OpenKai CLI + TUI \u2014 the operator surface for the OpenKai harness.",
  "type": "module",
  "bin": {
    "openkai": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/*.test.js",
    "test:build": "npm run -w @openkai/core build && npm run build && tsc -p tsconfig.test.json && node --test dist-test/*.test.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@openkai/core": "0.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  }
}